# Copy this file to .env and fill in the values:  cp .env.example .env

# MongoDB. docker-compose overrides this with the mongo container.
# For `go run .` with the compose mongo running:
MONGODB_URI=mongodb://localhost:27017

# livefxhub credential
FEED_API_KEY=
FEED_SECRET_KEY=

JWT_SECRET=
KYC_ENC_KEY=

# First admin account, created on startup if it doesn't exist
ADMIN_EMAIL=admin@kyc.local
ADMIN_PASSWORD=
